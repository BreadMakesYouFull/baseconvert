
FROM debian:trixie-slim

ARG PYSIDE_VERSION=6.12.0
ARG PYSIDE_BRANCH=6.12

ENV DEBIAN_FRONTEND=noninteractive
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PIP_NO_CACHE_DIR=1

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-venv \
    openjdk-21-jdk \
    git \
    curl \
    wget \
    build-essential \
    cmake \
    autoconf \
    automake \
    libtool \
    pkg-config \
    libffi-dev \
    libssl-dev \
    zlib1g-dev \
    libncurses-dev \
    zip \
    unzip \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

# Create the non-root build user
RUN useradd --create-home --uid 1000 builder

ENV HOME=/home/builder
ENV PATH="${JAVA_HOME}/bin:/home/builder/.venv/bin:${PATH}"

USER builder
WORKDIR /home/builder

# Builder-owned Python environment
RUN python3 -m venv /home/builder/.venv \
    && /home/builder/.venv/bin/pip install --upgrade pip

# Qt for Python deployment helper
ARG PYSIDE_BRANCH
RUN git clone --depth 1 --branch "${PYSIDE_BRANCH}" \
    https://code.qt.io/pyside/pyside-setup.git \
    /home/builder/pyside-setup \
    && pip install \
        -r /home/builder/pyside-setup/requirements.txt \
        -r /home/builder/pyside-setup/tools/cross_compile_android/requirements.txt

# Host deployment CLI and dependencies
RUN pip install \
    "PySide6==${PYSIDE_VERSION}" \
    jinja2 \
    pkginfo \
    tqdm \
    "packaging==24.1"

# Official Qt Android ARM64 wheels
RUN mkdir -p /home/builder/android-wheels \
    && curl -fL \
        "https://download.qt.io/official_releases/QtForPython/pyside6/pyside6-${PYSIDE_VERSION}-${PYSIDE_VERSION}-cp310-abi3-android_aarch64.whl" \
        -o "/home/builder/android-wheels/pyside6-${PYSIDE_VERSION}-${PYSIDE_VERSION}-cp310-abi3-android_aarch64.whl" \
    && curl -fL \
        "https://download.qt.io/official_releases/QtForPython/shiboken6/shiboken6-${PYSIDE_VERSION}-${PYSIDE_VERSION}-cp310-abi3-android_aarch64.whl" \
        -o "/home/builder/android-wheels/shiboken6-${PYSIDE_VERSION}-${PYSIDE_VERSION}-cp310-abi3-android_aarch64.whl"

# Android SDK, NDK and Python downloads
RUN python /home/builder/pyside-setup/tools/cross_compile_android/main.py \
    --download-only \
    --skip-update \
    --auto-accept-license

ENV ANDROIDSDK=/home/builder/.pyside6_android_deploy/android-sdk
ENV ANDROIDNDK=/home/builder/.pyside6_android_deploy/android-ndk/android-ndk-r28c

WORKDIR /workspace

ENTRYPOINT ["pyside6-android-deploy"]

